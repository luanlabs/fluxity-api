# ─────────────────────────────────────────────────────────────
# Fluxity API — environment configuration
# Copy to `.env` and fill in real values. All variables are validated
# at startup (see src/env.ts); the process exits with a clear report
# if anything is missing or malformed.
# ─────────────────────────────────────────────────────────────

# Runtime mode: development | production | test  (default: development)
NODE_ENV=development

# HTTP port the API listens on (default: 3000)
PORT=3000

# ── Database ──────────────────────────────────────────────────
# MongoDB connection string and database name
DB_URI=mongodb://127.0.0.1:27017
DB_NAME=fluxity

# ── Stellar / Soroban ─────────────────────────────────────────
# Base fee in stroops (numeric string, default: 100000)
BASE_FEE=100000

# Admin Stellar secret key (starts with "S"). Used to sign faucet/mint txs.
# KEEP THIS SECRET — never commit a real value.
ADMIN_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Soroban RPC endpoints
TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
MAINNET_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com

# Fluxity lockup contract ids (start with "C")
TESTNET_CONTRACT_ID=CD4VOKXNRCGJCRV2YFSTANCQYED7VTKL5W43YA4S5XDGBXK6EMBOEEAE
MAINNET_CONTRACT_ID=CD4VOKXNRCGJCRV2YFSTANCQYED7VTKL5W43YA4S5XDGBXK6EMBOEEAE

# Faucet amounts (numeric strings)
CLAIM_STREAM_AMOUNT=700
CLAIM_TOKEN_AMOUNT=10000000000

# ── Auth ──────────────────────────────────────────────────────
# Shared secret expected in the `Authorization` header for admin endpoints.
# Use a long, random value in production.
ADMIN_PASSWORD=change-me

# ── Logging ───────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal | silent  (default: info)
LOG_LEVEL=info
# Optional: in production, write JSON logs to this file instead of stdout.
# LOG_FILE_PATH=/app/storage/fluxity.log

# ── HTTP / CORS ───────────────────────────────────────────────
# "*" allows any origin, or a comma-separated allowlist
# (e.g. https://app.fluxity.finance,https://fluxity.finance). Default: *
CORS_ORIGIN=*
